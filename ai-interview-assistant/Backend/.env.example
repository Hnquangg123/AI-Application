OPENAI_API_KEY=your_real_api_key
# OPENAI_BASE_URL=   # leave unset for OpenAI's default; set a full https:// URL only for a custom/Azure endpoint
OPENAI_MODEL_CHAT=gpt-4o-mini
OPENAI_CHAT_API=auto

# Local PostgreSQL (compose.yaml / Rancher Desktop)
POSTGRES_DB=interview_assistant
POSTGRES_USER=interview_app
POSTGRES_PASSWORD=interview_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://interview_app:interview_dev_password@localhost:5432/interview_assistant
DATABASE_ECHO=false
FRONTEND_ORIGINS=["http://localhost:3000","http://localhost:3001"]